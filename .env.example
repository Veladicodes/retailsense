# Copy to .env and adjust. Defaults work for local SQLite + MinIO.
RETAILSENSE_DB_URL=sqlite:///data/retailsense.db
RETAILSENSE_DATA_DIR=data
RETAILSENSE_S3_BUCKET=retailsense
RETAILSENSE_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
